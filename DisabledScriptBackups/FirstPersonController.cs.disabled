		[Tooltip("Time between footstep sounds while crouching")]
		public float FootstepIntervalCrouch = 1.2f;
		[Range(0f, 1f)] public float FootstepVolume = 0.5f;

	[Tooltip("If true and only a single footstep clip is provided, treat it as a continuous looping footsteps recording")]
	public bool FootstepLoopIfSingleClip = true;
	[Tooltip("Pitch applied to the looping footstep clip at minimum speed")]
	public float FootstepLoopPitchMin = 0.95f;
	[Tooltip("Pitch applied to the looping footstep clip at maximum (sprint) speed")]
	public float FootstepLoopPitchMax = 1.2f;
	[Tooltip("Minimum volume multiplier for the looping clip when walking (scaled by speed up to 1)")]
	[Range(0f, 1f)] public float FootstepLoopMinVolumeScale = 0.75f;

	[Header("Heart Monitor Audio")]
	[Tooltip("AudioSource dedicated to the alive heart beep")]
