	[Tooltip("Minimum beep pitch when healthy")]
	public float HeartbeatPitchMin = 1.0f;
	[Tooltip("Maximum beep pitch when wounded")]
	public float HeartbeatPitchMax = 2.0f;
	[Tooltip("Minimum beep volume when healthy")]
	public float HeartbeatMinVolume = 0.4f;
		[Tooltip("Maximum beep volume when wounded")]
		public float HeartbeatMaxVolume = 1.0f;
		[Tooltip("Health ratio at or below which the player is considered wounded")]
		[Range(0f, 1f)] public float WoundedHealthThreshold = 0.35f;

		[Header("Damage Feedback")]
		[Tooltip("AudioSource dedicated to hurt sounds")]
		public AudioSource HurtAudioSource;
		[Tooltip("Collection of hurt/grunt sounds to play randomly on damage")]
		public AudioClip[] HurtClips;
		[Tooltip("Base volume for hurt sounds")]
		[Range(0f, 1f)] public float HurtVolume = 0.9f;
		[Tooltip("Enable random pitch variation for hurt sounds.")]
		public bool HurtPitchVariation = false;
		[Tooltip("Amount of random pitch variance for hurt sounds")]
		public float HurtPitchVariance = 0.08f;
		[Tooltip("Duration of the hurt screen flash")]
		public float HurtFlashDuration = 0.22f;
		[Tooltip("Overlay used for damage flash feedback")]
		public CanvasGroup HurtFlashOverlay;
		[Tooltip("If you use a blood texture, assign its RawImage here")]
		public RawImage HurtFlashImage;
		[Tooltip("Screen color used for the hurt flash")]
		public Color HurtFlashColor = new Color(1f, 0f, 0f, 0.35f);
		[Tooltip("Amplitude of the brief camera shake on damage")]
		public float HurtShakeAmplitude = 0.08f;
		[Tooltip("Duration of the brief camera shake on damage")]
		public float HurtShakeDuration = 0.16f;
		[Tooltip("Extra movement slowdown ratio while wounded")]
		[Range(0.5f, 1f)] public float WoundedSpeedMultiplier = 0.9f;

		[Header("Post Processing")]
		[Tooltip("Global volume that contains motion blur settings")]
		public Volume PostProcessVolume;
		[Tooltip("Minimum motion blur intensity when healthy")]
		[Range(0f, 1f)] public float MotionBlurMinIntensity = 0f;
		[Tooltip("Maximum motion blur intensity when low on health")]
		[Range(0f, 1f)] public float MotionBlurMaxIntensity = 1f;
		[Tooltip("Health ratio at which motion blur begins to ramp up")]
		[Range(0f, 1f)] public float MotionBlurStartHealth = 0.75f;
		[Tooltip("How fast motion blur intensity adapts to health changes")]
		public float MotionBlurSmoothSpeed = 4f;
		[Tooltip("If true, motion blur will use the highest quality mode")]
		public bool ForceHighQualityMotionBlur = true;

		// ─────────────────────────────────────────
		//  BREATHING / STAMINA AUDIO
		// ─────────────────────────────────────────
		[Header("Breathing Audio")]
		[Tooltip("AudioSource dedicated to breathing (looping)")]
		public AudioSource BreathingAudioSource;
		[Tooltip("Calm / idle breathing loop")]
		public AudioClip BreathCalm;
		[Tooltip("Moderate exertion breathing loop")]
		public AudioClip BreathMedium;
		[Tooltip("Near-exhausted heavy breathing loop")]
		public AudioClip BreathHeavy;
		[Tooltip("Completely exhausted / out-of-stamina breathing loop")]
		public AudioClip BreathExhausted;
		[Tooltip("How quickly the breathing volume fades in/out")]
		public float BreathFadeSpeed = 2.0f;
		[Range(0f, 1f)] [Tooltip("Maximum volume for calm breathing")]
		public float BreathCalmVolume = 0.35f;
		[Range(0f, 1f)] [Tooltip("Maximum volume for medium breathing")]
		public float BreathMediumVolume = 0.8f;
		[Range(0f, 1f)] [Tooltip("Maximum volume for heavy breathing")]
		public float BreathHeavyVolume = 0.8f;
		[Range(0f, 1f)] [Tooltip("Maximum volume for exhausted breathing")]
		public float BreathExhaustedVolume = 1.0f;

		// ─────────────────────────────────────────
		//  HEALTH
		// ─────────────────────────────────────────
		[Header("Player Health")]
		[Tooltip("Optional HealthComponent on the player.")]
		public HealthComponent PlayerHealth;
		[Tooltip("Optional HealthSettings asset used by health and HUD systems.")]
		public HealthSettings HealthSettings;

		[Header("Death")]
		[Tooltip("Time it takes to fade the screen and audio after death.")]
		public float DeathFadeDuration = 3.0f;
		[Tooltip("Delay after the fade completes before reloading the scene.")]
		public float DeathReloadDelay = 0.25f;

		// ─────────────────────────────────────────
		//  CINEMACHINE
		// ─────────────────────────────────────────
		[Header("Cinemachine")]
		public GameObject CinemachineCameraTarget;
		public float TopClamp = 90.0f;
		public float BottomClamp = -90.0f;

		[Header("Cinematic Camera Motion")]
		[Tooltip("Optional motion module used to add handheld, anxious body-camera feel without changing movement logic.")]
		public PsychologicalCameraMotion CameraMotion;

		// ══════════════════════════════════════════
		//  PRIVATE STATE
		// ══════════════════════════════════════════

		// movement
		private float _speed;
		private float _rotationVelocity;
		private float _verticalVelocity;
		private float _terminalVelocity = 53.0f;

		private float _targetYaw;
		private float _smoothYawVel;
		private float _smoothPitchVel;

		// timeout
		private float _jumpTimeoutDelta;
		private float _fallTimeoutDelta;

		// camera pitch
		private float _cinemachineTargetPitch;

		// stamina
		private float _currentStamina;
		private bool _isExhausted;          // locked out of sprinting until threshold recovered
		private float _staminaRegenTimer;    // countdown before regen begins

		// crouch
		private bool _isCrouching;
		private float _currentControllerHeight;
		private Vector3 _headBobBaseLocalPos;
		private float _bobTimer;
		private Vector3 _headBobInitialLocalPos;
		private Vector3 _crouchCameraBaseLocalPos;
		// footsteps
		private float _footstepTimer;

private float _madisonSwayTimer;
private Quaternion _madisonOriginalRotation;
private Vector3 _headBobPositionWithoutSway;

		// breathing layers
		private float _volCalm, _volMedium, _volHeavy, _volExhausted;
		private AudioSource _breathCalm_src, _breathMedium_src, _breathHeavy_src, _breathExhausted_src;
		private AudioSource _heartbeatSource;
		private AudioSource _deathBeepSource;
		private AudioSource _hurtSource;
		private MotionBlur _motionBlur;
		private float _motionBlurCurrent;
		private bool _deathProcessed;
		private bool _deathSequenceStarted;
		private float _deathAudioOriginalVolume;
		private CanvasGroup _deathFadeOverlay;
		private float _damageFeedbackTimer;
		private float _damageShakeTimer;
		private Quaternion _cameraOriginalLocalRotation;

		// components
		private CharacterController _controller;
		private StarterAssetsInputs _input;
#if ENABLE_INPUT_SYSTEM
        private PlayerInput _playerInput;
#endif
		private GameObject _mainCamera;

		private const float _threshold = 0.01f;

		private bool IsCurrentDeviceMouse
		{
			get
			{
#if ENABLE_INPUT_SYSTEM
                return _playerInput.currentControlScheme == "KeyboardMouse";
#else
				return false;
#endif
			}
		}

		// ══════════════════════════════════════════
		//  UNITY LIFECYCLE
		// ══════════════════════════════════════════

		private void Awake()
		{
			if (_mainCamera == null)
				_mainCamera = GameObject.FindGameObjectWithTag("MainCamera");
		}

		private void Start()
		{
			_controller = GetComponent<CharacterController>();
			_input = GetComponent<StarterAssetsInputs>();
#if ENABLE_INPUT_SYSTEM
            _playerInput = GetComponent<PlayerInput>();
#else
			Debug.LogError("Starter Assets package is missing dependencies. Please use Tools/Starter Assets/Reinstall Dependencies to fix it");
#endif
			_jumpTimeoutDelta = JumpTimeout;
			_fallTimeoutDelta = FallTimeout;

			// Stamina
			_currentStamina = MaxStamina;

			// Crouch
			_currentControllerHeight = PlayerCapsuleCollider != null
				? PlayerCapsuleCollider.height
				: StandHeight;
			_controller.height = _currentControllerHeight;

		if (HeadBobTarget != null)
		{
			_headBobBaseLocalPos = HeadBobTarget.localPosition;
			_headBobInitialLocalPos = _headBobBaseLocalPos;
		}

		if (CrouchCameraTarget == null && CinemachineCameraTarget != null)
		{
			CrouchCameraTarget = CinemachineCameraTarget.transform;
		}

		if (CrouchCameraTarget != null)
		{
			_crouchCameraBaseLocalPos = CrouchCameraTarget.localPosition;
		}

		_targetYaw = transform.eulerAngles.y;
		if (CinemachineCameraTarget != null)
		{
			float startingPitch = CinemachineCameraTarget.transform.localEulerAngles.x;
			_cinemachineTargetPitch = startingPitch > 180f ? startingPitch - 360f : startingPitch;
		}

		// Build layered breathing audio sources
		SetupBreathingLayers();
		SetupHeartbeatSource();
		SetupHurtAudioSource();
		SetupMotionBlur();

		// Ensure footstep audio source exists and configure looping clip if a single clip is provided
		if (FootstepAudioSource == null)
		{
			GameObject go = new GameObject("FootstepAudio");
			go.transform.SetParent(transform);
			go.transform.localPosition = Vector3.zero;
			FootstepAudioSource = go.AddComponent<AudioSource>();
			FootstepAudioSource.spatialBlend = 0f;
			FootstepAudioSource.playOnAwake = false;
		}

		if (FootstepClips != null && FootstepClips.Length == 1 && FootstepLoopIfSingleClip)
		{
			FootstepAudioSource.clip = FootstepClips[0];
			FootstepAudioSource.loop = true;
			FootstepAudioSource.volume = FootstepVolume;
			FootstepAudioSource.playOnAwake = false;
		}

		if (CameraMotion == null)
			CameraMotion = GetComponentInChildren<PsychologicalCameraMotion>();

		if (CameraMotion != null)
		{
			if (CameraMotion.MotionTarget == null)
				CameraMotion.MotionTarget = HeadBobTarget != null
					? HeadBobTarget
					: CinemachineCameraTarget != null
						? CinemachineCameraTarget.transform
						: _mainCamera != null
							? _mainCamera.transform
							: CameraMotion.transform;

			if (CameraMotion.MotionTarget == CameraMotion.transform)
			{
				Debug.LogWarning("PsychologicalCameraMotion is using its own GameObject as MotionTarget. Assign a camera or target transform to avoid moving the player root.", CameraMotion);
			}

			CameraMotion.SetSpeedReferences(MoveSpeed, SprintSpeed);
			CameraMotion.InitializeMotion();
		}

		InitializeHealth();
			CreateDeathFadeOverlay();
		if (_mainCamera != null)
			_cameraOriginalLocalRotation = _mainCamera.transform.localRotation;

	if (CinemachineCameraTarget != null)
		_madisonOriginalRotation = CinemachineCameraTarget.transform.localRotation;
	else if (_mainCamera != null)
		_madisonOriginalRotation = _mainCamera.transform.localRotation;
	}

	private void Update()
	{
		if (PlayerHealth != null && PlayerHealth.IsDead)
		{
			if (!_deathProcessed)
				HandlePlayerDeath();
			return;
		}

		JumpAndGravity();
		GroundedCheck();
		HandleCrouch();
		HandleStamina();
		Move();
			if (CameraMotion == null)
				HandleHeadBob();
			// Only use the legacy Madison sway when the new CameraMotion module is NOT present.
			if (EnableMadisonSway && CameraMotion == null)
				UpdateMadisonSway();
		HandleFootsteps();
		UpdateHeartbeatAudio();
		UpdateBreathingAudio();
		UpdateDamageFeedback();
		UpdateMotionBlur();
	}

	private void LateUpdate()
	{
		CameraRotation();

		if (CameraMotion != null)
		{
			CameraMotion.UpdateCameraMotion(
				Time.deltaTime,
				_input.look,
				_input.move,
				_controller.velocity,
				CanSprint(),
				Grounded,
				_isCrouching,
				_speed);
		}
	}

		// ══════════════════════════════════════════
		//  GROUND CHECK
		// ══════════════════════════════════════════

		private void GroundedCheck()
		{
			Vector3 spherePosition = new Vector3(
				transform.position.x,
				transform.position.y - GroundedOffset,
				transform.position.z);
			Grounded = Physics.CheckSphere(spherePosition, GroundedRadius, GroundLayers, QueryTriggerInteraction.Ignore);
		}

		// ══════════════════════════════════════════
		//  CAMERA ROTATION
		// ══════════════════════════════════════════

		private void CameraRotation()
		{
		float deltaTimeMultiplier = IsCurrentDeviceMouse ? 1.0f : Time.deltaTime;

		if (_input.look.sqrMagnitude >= _threshold)
		{
			_cinemachineTargetPitch += _input.look.y * RotationSpeed * deltaTimeMultiplier;
			_targetYaw += _input.look.x * RotationSpeed * deltaTimeMultiplier;

			_cinemachineTargetPitch = ClampAngle(_cinemachineTargetPitch, BottomClamp, TopClamp);
		}

		float currentPitch = 0f;
		if (CinemachineCameraTarget != null)
		{
			currentPitch = CinemachineCameraTarget.transform.localEulerAngles.x;
			if (currentPitch > 180f)
				currentPitch -= 360f;
		}

		float smoothPitch = Mathf.SmoothDamp(
			currentPitch,
			_cinemachineTargetPitch,
			ref _smoothPitchVel,
			CameraMotion != null ? CameraMotion.RotationSmoothTime : 0.08f,
			Mathf.Infinity,
			Time.deltaTime);

		float smoothYaw = Mathf.SmoothDampAngle(
			transform.eulerAngles.y,
			_targetYaw,
			ref _smoothYawVel,
			CameraMotion != null ? CameraMotion.RotationSmoothTime : 0.08f,
			Mathf.Infinity,
			Time.deltaTime);

		if (CinemachineCameraTarget != null)
		{
			CinemachineCameraTarget.transform.localRotation =
				Quaternion.Euler(smoothPitch, 0.0f, 0.0f);
		}

		transform.rotation = Quaternion.Euler(0.0f, smoothYaw, 0.0f);
	}

		// ══════════════════════════════════════════
		//  CROUCH
		// ══════════════════════════════════════════

		private void HandleCrouch()
		{
			if (_input.crouch)
			{
				_input.crouch = false; // consume the input

				if (_isCrouching)
				{
					// Try to stand — check headroom
					if (!CeilingAbove())
						_isCrouching = false;
				}
				else
				{
					_isCrouching = true;
				}
			}

			float targetHeight = _isCrouching ? CrouchHeight : StandHeight;
			_currentControllerHeight = Mathf.MoveTowards(
				_currentControllerHeight,
				targetHeight,
				CrouchTransitionSpeed * Time.deltaTime);
			if (PlayerCapsuleCollider != null)
			{
				PlayerCapsuleCollider.height = _currentControllerHeight;
				Vector3 capsuleCenter = PlayerCapsuleCollider.center;
				capsuleCenter.y = _currentControllerHeight / 2f;
				PlayerCapsuleCollider.center = capsuleCenter;
			}

			_controller.height = _currentControllerHeight;

			if (HeadBobTarget != null)
			{
				_headBobBaseLocalPos = _headBobInitialLocalPos;
				_headBobBaseLocalPos.y -= StandHeight - _currentControllerHeight;
			}

			if (CrouchCameraTarget != null && CrouchCameraTarget != HeadBobTarget)
			{
				Vector3 cameraPos = _crouchCameraBaseLocalPos;
				cameraPos.y -= StandHeight - _currentControllerHeight;
				CrouchCameraTarget.localPosition = cameraPos;
			}

			// Keep the controller centred vertically
			Vector3 center = _controller.center;
			center.y = _currentControllerHeight / 2f;
			_controller.center = center;
		}

		private bool CeilingAbove()
		{
			float radius = PlayerCapsuleCollider != null ? PlayerCapsuleCollider.radius : _controller.radius;
			return Physics.SphereCast(
				transform.position,
				radius,
				Vector3.up,
				out _,
				StandHeight - CrouchHeight + 0.1f,
				GroundLayers);
		}

		// ══════════════════════════════════════════
		//  STAMINA
		// ══════════════════════════════════════════

		private void HandleStamina()
		{
			bool wantsToSprint = _input.sprint &&
								 _input.move != Vector2.zero &&
								 !_isCrouching &&
								 Grounded;

			bool actuallySprintig = wantsToSprint && _currentStamina > 0f && !_isExhausted;

			if (actuallySprintig)
			{
				_currentStamina -= StaminaDrainRate * Time.deltaTime;
				_staminaRegenTimer = StaminaRegenDelay;

				if (_currentStamina <= 0f)
				{
					_currentStamina = 0f;
					_isExhausted = true;
				}
			}
			else
			{
				// Countdown regen delay timer every frame
				if (_staminaRegenTimer > 0f)
				{
					_staminaRegenTimer -= Time.deltaTime;
				}

				// Regenerate stamina once delay is over
				if (_staminaRegenTimer <= 0f)
				{
					_currentStamina = Mathf.Min(MaxStamina,
						_currentStamina + StaminaRegenRate * Time.deltaTime);
				}

				// Lift exhaustion lock once threshold is recovered
				if (_isExhausted && _currentStamina >= StaminaSprintThreshold)
					_isExhausted = false;
			}
		}

		// Helper: can the player sprint right now?
		private bool CanSprint()
		{
			return _input.sprint &&
				   _input.move != Vector2.zero &&
				   !_isCrouching &&
				   Grounded &&
				   _currentStamina > 0f &&
				   !_isExhausted;
		}

		// ══════════════════════════════════════════
		//  MOVE
		// ══════════════════════════════════════════

		private void Move()
		{
			float targetSpeed;
			if (_isCrouching)
				targetSpeed = CrouchSpeed;
			else if (CanSprint())
				targetSpeed = SprintSpeed;
			else
				targetSpeed = MoveSpeed;

			if (_input.move == Vector2.zero) targetSpeed = 0.0f;

			float currentHorizontalSpeed = new Vector3(
				_controller.velocity.x, 0.0f, _controller.velocity.z).magnitude;

			float speedOffset = 0.1f;
			float inputMagnitude = _input.analogMovement ? _input.move.magnitude : 1f;

			if (currentHorizontalSpeed < targetSpeed - speedOffset ||
				currentHorizontalSpeed > targetSpeed + speedOffset)
			{
				_speed = Mathf.Lerp(currentHorizontalSpeed,
					targetSpeed * inputMagnitude,
					Time.deltaTime * SpeedChangeRate);
				_speed = Mathf.Round(_speed * 1000f) / 1000f;
			}
			else
			{
				_speed = targetSpeed;
			}

			Vector3 inputDirection = new Vector3(_input.move.x, 0.0f, _input.move.y).normalized;
			if (_input.move != Vector2.zero)
				inputDirection = transform.right * _input.move.x + transform.forward * _input.move.y;

			_controller.Move(
				inputDirection.normalized * (_speed * Time.deltaTime) +
				new Vector3(0.0f, _verticalVelocity, 0.0f) * Time.deltaTime);
		}

		// ══════════════════════════════════════════
		//  JUMP & GRAVITY
		// ══════════════════════════════════════════

		private void JumpAndGravity()
		{
			if (Grounded)
			{
				_fallTimeoutDelta = FallTimeout;

				if (_verticalVelocity < 0.0f)
					_verticalVelocity = -2f;

				float minStaminaToJump = MaxStamina * 0.20f;
				if (_input.jump && _jumpTimeoutDelta <= 0.0f && !_isCrouching && _currentStamina >= JumpStaminaCost && _currentStamina >= minStaminaToJump)
				{
					// Drain stamina for jump
					_currentStamina -= JumpStaminaCost;
					if (_currentStamina < 0f)
						_currentStamina = 0f;

					_verticalVelocity = Mathf.Sqrt(JumpHeight * -2f * Gravity);
				}

				if (_jumpTimeoutDelta >= 0.0f)
					_jumpTimeoutDelta -= Time.deltaTime;
			}
			else
			{
				_jumpTimeoutDelta = JumpTimeout;

				if (_fallTimeoutDelta >= 0.0f)
					_fallTimeoutDelta -= Time.deltaTime;

				_input.jump = false;
			}

			if (_verticalVelocity < _terminalVelocity)
				_verticalVelocity += Gravity * Time.deltaTime;
		}

		// ══════════════════════════════════════════
		//  HEAD BOB
		// ══════════════════════════════════════════

		private void HandleHeadBob()
		{
			if (HeadBobTarget == null) return;

			float horizontal = new Vector3(
				_controller.velocity.x, 0f, _controller.velocity.z).magnitude;

			bool moving = horizontal > 0.1f && Grounded;

			if (moving)
			{
				float freq, amp;
				if (_isCrouching) { freq = CrouchBobFrequency; amp = CrouchBobAmplitude; }
				else if (CanSprint()) { freq = SprintBobFrequency; amp = SprintBobAmplitude; }
				else { freq = WalkBobFrequency; amp = WalkBobAmplitude; }

				_bobTimer += Time.deltaTime * freq * Mathf.PI * 2f;

				float bobY = Mathf.Sin(_bobTimer) * amp;
				float bobX = Mathf.Cos(_bobTimer * 0.5f) * amp * 0.5f;

				HeadBobTarget.localPosition = _headBobBaseLocalPos + new Vector3(bobX, bobY, 0f);
			}
			else
			{
				// Smoothly return to rest, with optional exhaustion sway
				float staminaRatio = _currentStamina / MaxStamina;
				float sway = (1f - staminaRatio) * ExhaustionSwayAmount *
							 Mathf.Sin(Time.time * 1.2f);

				Vector3 restPos = _headBobBaseLocalPos + new Vector3(sway, 0f, 0f);
				HeadBobTarget.localPosition = Vector3.Lerp(
					HeadBobTarget.localPosition, restPos, Time.deltaTime * 6f);

				_bobTimer = 0f;
			}
		}

		// ══════════════════════════════════════════
		//  FOOTSTEPS
	private void UpdateMadisonSway()
	{
		if (HeadBobTarget == null && CinemachineCameraTarget == null)
			return;

		_madisonSwayTimer += Time.deltaTime;
		float healthRatio = GetHealthRatio();
		float staminaRatio = MaxStamina > 0f ? _currentStamina / MaxStamina : 1f;
		float healthStress = Mathf.Clamp01(1f - healthRatio) * MadisonSwayHealthMultiplier;
		float exhaustionStress = Mathf.Clamp01(1f - staminaRatio) * MadisonSwayExhaustionMultiplier;
		float swayIntensity = 1f + healthStress + exhaustionStress;
		
		float primarySway = Mathf.Sin(_madisonSwayTimer * MadisonSwayFrequency * Mathf.PI * 2f);
		float secondarySway = Mathf.Sin(_madisonSwayTimer * MadisonSwayFrequencySecondary * Mathf.PI * 2f);
		
		float offsetX = primarySway * MadisonSwayStrengthX * swayIntensity;
		float offsetY = secondarySway * MadisonSwayStrengthY * swayIntensity * 0.7f;
		offsetY += Mathf.Cos(_madisonSwayTimer * MadisonSwayFrequency * 1.5f * Mathf.PI * 2f) * 
				   MadisonSwayStrengthY * swayIntensity * 0.3f;
		
		if (HeadBobTarget != null)
			HeadBobTarget.localPosition += new Vector3(offsetX, offsetY, 0f);
		
		float tiltAmount = Mathf.Cos(_madisonSwayTimer * MadisonSwayFrequency * 0.7f * Mathf.PI * 2f) * 
						  MadisonSwayTiltZ * swayIntensity;
		
		if (CinemachineCameraTarget != null)
		{
			Quaternion swayRotation = _madisonOriginalRotation * Quaternion.Euler(0f, 0f, tiltAmount);
			CinemachineCameraTarget.transform.localRotation = swayRotation;
		}
		else if (_mainCamera != null)
		{
			Quaternion swayRotation = _cameraOriginalLocalRotation * Quaternion.Euler(0f, 0f, tiltAmount);
			_mainCamera.transform.localRotation = swayRotation;
		}
	}


		// ══════════════════════════════════════════

		private void HandleFootsteps()
		{
			if (FootstepAudioSource == null || FootstepClips == null || FootstepClips.Length == 0)
				return;

			float horizontal = new Vector3(
				_controller.velocity.x, 0f, _controller.velocity.z).magnitude;

			if (horizontal < 0.01f || !Grounded)
			{
				_footstepTimer = 0f;
				// stop looping continuous clip when we stop moving
				if (FootstepClips.Length == 1 && FootstepLoopIfSingleClip && FootstepAudioSource.isPlaying)
					FootstepAudioSource.Stop();
				return;
			}

			// If single long clip provided, play it as a loop and modulate pitch/volume by speed
			if (FootstepClips.Length == 1 && FootstepLoopIfSingleClip)
			{
				if (!FootstepAudioSource.isPlaying)
					FootstepAudioSource.Play();

				float speedRatio = Mathf.Clamp01(horizontal / SprintSpeed);
				float pitch = Mathf.Lerp(FootstepLoopPitchMin, FootstepLoopPitchMax, speedRatio);
				FootstepAudioSource.pitch = pitch;
				FootstepAudioSource.volume = FootstepVolume * Mathf.Lerp(FootstepLoopMinVolumeScale, 1f, speedRatio);
				return;
			}

			float interval;
			if (_isCrouching)
			{
				interval = FootstepIntervalCrouch;
			}
			else
			{
				float speedRatio = Mathf.Clamp01(horizontal / SprintSpeed);
				interval = Mathf.Lerp(FootstepIntervalWalk, FootstepIntervalSprint, speedRatio);
			}

			_footstepTimer -= Time.deltaTime;
			if (_footstepTimer <= 0f)
			{
				AudioClip clip = FootstepClips[UnityEngine.Random.Range(0, FootstepClips.Length)];
				FootstepAudioSource.PlayOneShot(clip, FootstepVolume);
				_footstepTimer = interval;
			}
		}

		// ══════════════════════════════════════════
		//  BREATHING AUDIO SYSTEM
		//  Four layered loops fade in/out based on
		//  stamina level, giving a smooth escalating
		//  breathing effect as stamina depletes.
		// ══════════════════════════════════════════

		/// <summary>
		/// Create child AudioSources for each breathing layer so they all
		/// play simultaneously at different volumes.
		/// </summary>
		private void SetupHeartbeatSource()
		{
			if (HeartbeatClip == null)
				return;

			if (HeartbeatAudioSource != null)
			{
				_heartbeatSource = HeartbeatAudioSource;
			}
			else
			{
				GameObject go = new GameObject("HeartbeatAudio");
				go.transform.SetParent(transform);
				go.transform.localPosition = Vector3.zero;
				_heartbeatSource = go.AddComponent<AudioSource>();
			}

			_heartbeatSource.clip = HeartbeatClip;
			_heartbeatSource.loop = true;
			_heartbeatSource.spatialBlend = 0f;
			_heartbeatSource.playOnAwake = false;
			_heartbeatSource.volume = HeartbeatMinVolume;
			_heartbeatSource.pitch = HeartbeatPitchMin;
			_heartbeatSource.Play();

			if (DeathBeepClip != null)
			{
				GameObject go = new GameObject("DeathBeepAudio");
				go.transform.SetParent(transform);
				go.transform.localPosition = Vector3.zero;
				_deathBeepSource = go.AddComponent<AudioSource>();
				_deathBeepSource.clip = DeathBeepClip;
				_deathBeepSource.loop = true;
				_deathBeepSource.spatialBlend = 0f;
				_deathBeepSource.playOnAwake = false;
				_deathBeepSource.volume = HeartbeatMaxVolume;
			}
		}

		private void SetupHurtAudioSource()
		{
			if (HurtClips == null || HurtClips.Length == 0)
				return;

			if (HurtAudioSource != null && HurtAudioSource == _heartbeatSource)
			{
				HurtAudioSource = null;
				Debug.LogWarning("HurtAudioSource was assigned the same AudioSource as HeartbeatAudioSource. Creating a dedicated hurt AudioSource.", this);
			}

			if (HurtAudioSource != null)
			{
				_hurtSource = HurtAudioSource;
			}
			else
			{
				GameObject go = new GameObject("HurtAudio");
				go.transform.SetParent(transform);
				go.transform.localPosition = Vector3.zero;
				_hurtSource = go.AddComponent<AudioSource>();
			}

			if (_hurtSource == _heartbeatSource)
			{
				GameObject go = new GameObject("HurtAudioOverride");
				go.transform.SetParent(transform);
				go.transform.localPosition = Vector3.zero;
				_hurtSource = go.AddComponent<AudioSource>();
				Debug.LogWarning("Created a dedicated hurt AudioSource because the heartbeat source was already being used.", this);
			}

			_hurtSource.loop = false;
			_hurtSource.spatialBlend = 0f;
			_hurtSource.playOnAwake = false;
		}

	private void HandlePlayerDamage(float damage)
	{
		TriggerDamageFeedback(damage);
	}

	private void TriggerDamageFeedback(float damage)
	{
		if (_hurtSource != null && HurtClips != null && HurtClips.Length > 0)
		{
			AudioClip randomHurtClip = HurtClips[UnityEngine.Random.Range(0, HurtClips.Length)];
			_hurtSource.pitch = HurtPitchVariation ? 1f + UnityEngine.Random.Range(-HurtPitchVariance, HurtPitchVariance) : 1f;
			_hurtSource.PlayOneShot(randomHurtClip, HurtVolume);
		}

		_damageFeedbackTimer = HurtFlashDuration;
		_damageShakeTimer = HurtShakeDuration;

		if (HurtFlashOverlay != null)
		{
			HurtFlashOverlay.alpha = HurtFlashColor.a;
			HurtFlashOverlay.gameObject.SetActive(true);
		}
		if (HurtFlashImage != null)
		{
			Color imageColor = HurtFlashColor;
			HurtFlashImage.color = imageColor;
			HurtFlashImage.gameObject.SetActive(true);
		}
	}

	private void UpdateDamageFeedback()
		{
			float healthRatio = GetHealthRatio();
			float healthAlpha = Mathf.Clamp01(1f - healthRatio) * HurtFlashColor.a;
			float alpha = healthAlpha;

			if (_damageFeedbackTimer > 0f)
			{
				_damageFeedbackTimer -= Time.deltaTime;
				float pulseAlpha = Mathf.Clamp01(_damageFeedbackTimer / HurtFlashDuration) * HurtFlashColor.a;
				alpha = Mathf.Max(alpha, pulseAlpha);
			}

			if (HurtFlashOverlay != null)
			{
				HurtFlashOverlay.alpha = alpha;
				HurtFlashOverlay.gameObject.SetActive(alpha > 0f);
			}
			if (HurtFlashImage != null)
			{
				Color imageColor = HurtFlashImage.color;
				imageColor.a = alpha;
				HurtFlashImage.color = imageColor;
				HurtFlashImage.gameObject.SetActive(alpha > 0f);
			}

			if (_damageShakeTimer > 0f && _mainCamera != null)
			{
				_damageShakeTimer -= Time.deltaTime;
				float shakeStrength = Mathf.Clamp01(_damageShakeTimer / HurtShakeDuration) * HurtShakeAmplitude;
				Quaternion shakeRotation = Quaternion.Euler(
					UnityEngine.Random.Range(-shakeStrength, shakeStrength) * 10f,
					UnityEngine.Random.Range(-shakeStrength, shakeStrength) * 10f,
					0f);
				_mainCamera.transform.localRotation = _cameraOriginalLocalRotation * shakeRotation;
			}
			else
			{
				_mainCamera.transform.localRotation = _cameraOriginalLocalRotation;
			}
		}

		private void SetupMotionBlur()
		{
			if (PostProcessVolume == null || PostProcessVolume.profile == null)
				return;

			if (!PostProcessVolume.profile.TryGet<MotionBlur>(out _motionBlur))
				return;

			_motionBlur.intensity.overrideState = true;
			_motionBlur.intensity.value = MotionBlurMinIntensity;

			if (ForceHighQualityMotionBlur)
			{
				_motionBlur.quality.overrideState = true;
				_motionBlur.quality.value = MotionBlurQuality.High;
			}

			_motionBlurCurrent = MotionBlurMinIntensity;
		}

		private void UpdateMotionBlur()
		{
			if (_motionBlur == null)
				return;

			float healthRatio = GetHealthRatio();
			float t = Mathf.InverseLerp(MotionBlurStartHealth, 0f, healthRatio);
			float target = Mathf.Lerp(MotionBlurMinIntensity, MotionBlurMaxIntensity, t);
			_motionBlurCurrent = Mathf.MoveTowards(_motionBlurCurrent, target, MotionBlurSmoothSpeed * Time.deltaTime);
			_motionBlur.intensity.value = _motionBlurCurrent;
		}

		private void UpdateHeartbeatAudio()
		{
			if (_heartbeatSource == null)
				return;

			bool isDead = PlayerHealth != null && PlayerHealth.IsDead;
			if (isDead)
			{
				if (_heartbeatSource.isPlaying)
					_heartbeatSource.Stop();
				StartDeathBeep();
				return;
			}

			StopDeathBeep();

			if (!_heartbeatSource.isPlaying)
				_heartbeatSource.Play();

			float healthRatio = GetHealthRatio();
			float heartbeatPitch = Mathf.Lerp(HeartbeatPitchMax, HeartbeatPitchMin, healthRatio);
			float heartbeatVolume = Mathf.Lerp(HeartbeatMaxVolume, HeartbeatMinVolume, healthRatio);

			_heartbeatSource.pitch = heartbeatPitch;
			_heartbeatSource.volume = heartbeatVolume;
		}

		private void StartDeathBeep()
		{
			if (_deathBeepSource == null || _deathBeepSource.isPlaying)
				return;

			_deathBeepSource.Play();
		}

		private void StopDeathBeep()
		{
			if (_deathBeepSource == null || !_deathBeepSource.isPlaying)
				return;

			_deathBeepSource.Stop();
		}

		private float GetHealthRatio()
		{
			if (PlayerHealth == null)
				return 1f;

			Type healthType = PlayerHealth.GetType();
			var currentProp = healthType.GetProperty("CurrentHealth") ?? healthType.GetProperty("Health") ?? healthType.GetProperty("HitPoints");
			var maxProp = healthType.GetProperty("MaxHealth") ?? healthType.GetProperty("HealthMax") ?? healthType.GetProperty("MaxHitPoints");

			if (currentProp == null || maxProp == null)
				return 1f;

			float current = Convert.ToSingle(currentProp.GetValue(PlayerHealth));
			float max = Convert.ToSingle(maxProp.GetValue(PlayerHealth));
			return max > 0f ? Mathf.Clamp01(current / max) : 1f;
		}

		private void InitializeHealth()
		{
			if (PlayerHealth == null)
				PlayerHealth = GetComponent<HealthComponent>();

			if (PlayerHealth == null)
				PlayerHealth = gameObject.AddComponent<HealthComponent>();

			if (HealthSettings != null)
				PlayerHealth.HealthSettingsAsset = HealthSettings;

			PlayerHealth.OnDeath += HandlePlayerDeath;
			PlayerHealth.OnDamageTaken += HandlePlayerDamage;
		}

		private void OnDisable()
		{
			if (PlayerHealth != null)
			{
				PlayerHealth.OnDeath -= HandlePlayerDeath;
				PlayerHealth.OnDamageTaken -= HandlePlayerDamage;
			}
		}

		public void ApplyDamage(float damage)
		{
			PlayerHealth?.TakeDamage(damage);
		}

		public void ApplyHealing(float amount)
		{
			PlayerHealth?.Heal(amount);
		}

		private void HandlePlayerDeath()
		{
			_deathProcessed = true;

			if (_input != null)
			{
				_input.move = Vector2.zero;
				_input.sprint = false;
				_input.jump = false;
				_input.crouch = false;
			}

			if (FootstepAudioSource != null)
				FootstepAudioSource.Stop();

			if (_heartbeatSource != null && _heartbeatSource.isPlaying)
				_heartbeatSource.Stop();

			StartDeathBeep();

			_deathAudioOriginalVolume = AudioListener.volume;
			if (!_deathSequenceStarted)
			{
				_deathSequenceStarted = true;
				StartCoroutine(DeathSequence());
			}

			_footstepTimer = 0f;
		}

		private IEnumerator DeathSequence()
		{
			if (_deathFadeOverlay != null)
			{
				_deathFadeOverlay.gameObject.SetActive(true);
				_deathFadeOverlay.alpha = 0f;
			}

			float timer = 0f;
			while (timer < DeathFadeDuration)
			{
				timer += Time.unscaledDeltaTime;
				float t = Mathf.Clamp01(timer / DeathFadeDuration);

				if (_deathFadeOverlay != null)
					_deathFadeOverlay.alpha = t;

				AudioListener.volume = Mathf.Lerp(_deathAudioOriginalVolume, 0f, t);
				yield return null;
			}

			if (_deathFadeOverlay != null)
				_deathFadeOverlay.alpha = 1f;

			AudioListener.volume = 0f;
			if (_deathBeepSource != null)
				_deathBeepSource.volume = 0f;

			yield return new WaitForSecondsRealtime(DeathReloadDelay);
			SceneManager.LoadScene(SceneManager.GetActiveScene().buildIndex);
		}

		private void CreateDeathFadeOverlay()
		{
			if (_deathFadeOverlay != null)
				return;

			GameObject canvasGo = new GameObject("DeathFadeCanvas");
			canvasGo.transform.SetParent(transform, false);

			Canvas canvas = canvasGo.AddComponent<Canvas>();
			canvas.renderMode = RenderMode.ScreenSpaceOverlay;
			canvas.sortingOrder = 1000;
			canvasGo.AddComponent<CanvasScaler>();
			canvasGo.AddComponent<GraphicRaycaster>();

			GameObject imageGo = new GameObject("DeathFadeImage");
			imageGo.transform.SetParent(canvasGo.transform, false);

			RectTransform rectTransform = imageGo.AddComponent<RectTransform>();
			rectTransform.anchorMin = Vector2.zero;
			rectTransform.anchorMax = Vector2.one;
			rectTransform.offsetMin = Vector2.zero;
			rectTransform.offsetMax = Vector2.zero;

			Image image = imageGo.AddComponent<Image>();
			image.color = Color.black;

			CanvasGroup canvasGroup = imageGo.AddComponent<CanvasGroup>();
			canvasGroup.alpha = 0f;
			canvasGroup.blocksRaycasts = false;
			canvasGroup.interactable = false;

			_deathFadeOverlay = canvasGroup;
		}

		private void SetupBreathingLayers()
		{
			_breathCalm_src = CreateBreathSource("Breath_Calm", BreathCalm);
			_breathMedium_src = CreateBreathSource("Breath_Medium", BreathMedium);
			_breathHeavy_src = CreateBreathSource("Breath_Heavy", BreathHeavy);
			_breathExhausted_src = CreateBreathSource("Breath_Exhausted", BreathExhausted);
		}

		private AudioSource CreateBreathSource(string goName, AudioClip clip)
		{
			if (clip == null) return null;

			GameObject go = new GameObject(goName);
			go.transform.SetParent(transform);
			go.transform.localPosition = Vector3.zero;

			AudioSource src = go.AddComponent<AudioSource>();
			src.clip = clip;
			src.loop = true;
			src.volume = 0f;
			src.spatialBlend = 0f; // 2D — it's the player's own breath
			src.Play();
			return src;
		}

		private void UpdateBreathingAudio()
		{
			// staminaRatio: 1 = full, 0 = empty
			float staminaRatio = MaxStamina > 0f ? _currentStamina / MaxStamina : 0f;

			bool isSprinting = CanSprint();
			bool isMoving = _input.move != Vector2.zero;

			// --- Determine target volumes ---

			// CALM: only audible when the player is not exerting and stamina is near full
			float targetCalm = 0f;
			if (!isSprinting && staminaRatio > 0.8f)
				targetCalm = 1f; // calm breathing only when not under exertion

			// MEDIUM: walking/light exertion or early sprint
			float targetMedium = 0f;
			if (isSprinting && staminaRatio > 0.5f)
				targetMedium = Mathf.InverseLerp(1f, 0.5f, staminaRatio); // 0→1 as stamina goes 100%→50%
			else if (!isSprinting && staminaRatio <= 0.8f && staminaRatio > 0.4f)
				targetMedium = Mathf.InverseLerp(0.8f, 0.4f, staminaRatio);

			// HEAVY: mid–low stamina while sprinting
			float targetHeavy = 0f;
			if (staminaRatio <= 0.5f && staminaRatio > 0.15f)
				targetHeavy = Mathf.InverseLerp(0.5f, 0.15f, staminaRatio);

			// EXHAUSTED: near/at zero stamina
			float targetExhausted = 0f;
			if (staminaRatio <= 0.2f)
				targetExhausted = Mathf.InverseLerp(0.2f, 0f, staminaRatio);

			// --- Fade volumes ---
			float speed = BreathFadeSpeed * Time.deltaTime;

			FadeBreath(_breathCalm_src, ref _volCalm, targetCalm * BreathCalmVolume, speed);
			FadeBreath(_breathMedium_src, ref _volMedium, targetMedium * BreathMediumVolume, speed);
			FadeBreath(_breathHeavy_src, ref _volHeavy, targetHeavy * BreathHeavyVolume, speed);
			FadeBreath(_breathExhausted_src, ref _volExhausted, targetExhausted * BreathExhaustedVolume, speed);
		}

		private static void FadeBreath(AudioSource src, ref float current, float target, float speed)
		{
			if (src == null) return;
			current = Mathf.MoveTowards(current, target, speed);
			src.volume = current;
		}

		// ══════════════════════════════════════════
		//  HELPERS
		// ══════════════════════════════════════════

		private static float ClampAngle(float lfAngle, float lfMin, float lfMax)
		{
			if (lfAngle < -360f) lfAngle += 360f;
			if (lfAngle > 360f) lfAngle -= 360f;
			return Mathf.Clamp(lfAngle, lfMin, lfMax);
		}

		// ── Public accessors (UI / other systems) ──────────────────────────

		/// <summary>Returns stamina as a 0–1 ratio (useful for UI stamina bars).</summary>
		public float StaminaRatio => MaxStamina > 0f ? _currentStamina / MaxStamina : 0f;

		/// <summary>True when the player is currently exhausted (out of stamina).</summary>
		public bool IsExhausted => _isExhausted;

		/// <summary>True when the player is crouching.</summary>
		public bool IsCrouching => _isCrouching;

		// ══════════════════════════════════════════
		//  GIZMOS
		// ══════════════════════════════════════════

		private void OnDrawGizmosSelected()
		{
			Gizmos.color = Grounded
				? new Color(0f, 1f, 0f, 0.35f)
				: new Color(1f, 0f, 0f, 0.35f);

			Gizmos.DrawSphere(
				new Vector3(transform.position.x,
							transform.position.y - GroundedOffset,
							transform.position.z),
				GroundedRadius);
		}
	}
}