	[RequireComponent(typeof(AudioSource))]
#if ENABLE_INPUT_SYSTEM
    [RequireComponent(typeof(PlayerInput))]
#endif
	public class FirstPersonController : MonoBehaviour
	{
		// ─────────────────────────────────────────
		//  MOVEMENT
		// ─────────────────────────────────────────
		[Header("Player Movement")]
