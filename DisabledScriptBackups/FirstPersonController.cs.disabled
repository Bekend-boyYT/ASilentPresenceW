		public float WalkBobFrequency = 1.8f;
		public float WalkBobAmplitude = 0.04f;
		public float SprintBobFrequency = 2.8f;
		public float SprintBobAmplitude = 0.07f;
		public float CrouchBobFrequency = 1.2f;
		public float CrouchBobAmplitude = 0.02f;
		[Tooltip("Breathing sway at high exhaustion")]
		public float ExhaustionSwayAmount = 0.03f;

[Header("Madison Sway (Horror)")]
[Tooltip("Enable the unsettling Madison camera sway effect")]
public bool EnableMadisonSway = true;
[Tooltip("Base horizontal sway amount")]
public float MadisonSwayStrengthX = 0.08f;
[Tooltip("Base vertical sway amount")]
public float MadisonSwayStrengthY = 0.06f;
[Tooltip("Slight camera tilt during sway")]
public float MadisonSwayTiltZ = 2f;
[Tooltip("Speed of the primary sway oscillation")]
public float MadisonSwayFrequency = 0.5f;
[Tooltip("Speed of the secondary sway for variation")]
