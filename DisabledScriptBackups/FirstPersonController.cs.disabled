[Tooltip("How much exhaustion intensifies the sway")]
public float MadisonSwayExhaustionMultiplier = 1.5f;
[Tooltip("How much low health intensifies the sway")]
public float MadisonSwayHealthMultiplier = 1.2f;

		// ─────────────────────────────────────────
